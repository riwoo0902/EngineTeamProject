  TitleText: "\uC878\uB9B0 \uC2AC\uB77C\uC784"
  StoryText: "\uC791\uACE0 \uD22C\uBA85\uD55C \uC2AC\uB77C\uC784\uC774 \uAFB8\uBC85\uAFB8\uBC85
    \uC878\uACE0 \uC788\uB2E4.\n\uC2AC\uB77C\uC784\uC740 \uB124\uAC00 \uB2E4\uAC00\uC624\uC790
    \uB208\uC744 \uBE44\uBE44\uBA70 \uC791\uAC8C \uC18D\uC0AD\uC774\uACE0 \uC788\uB2E4.\n\n\u201C\uBB58
    \uAF34\uC544\uBD10..\u201D"
  EventSprite: {fileID: 21300000, guid: 1cef50138dd8b446783f4d4cd318741e, type: 3}
  Choices:
  - ButtonText: "\uAC15\uC7AC\uB85C \uC2AC\uB77C\uC784\uC744 \uAE68\uC6B4\uB2E4."
    EffectType: 3
    EffectValue: 1
    Items:
    - {fileID: 11400000, guid: 944c17606f1a02b45850c15394184668, type: 2}
    PinBalls: []
    ChoiceText: "\uC2AC\uB77C\uC784\uC740 \uB5A0\uB098\uBC84\uB838\uACE0 \uADF8 \uC790\uB9AC\uC5D4
      \uC2AC\uB77C\uC784 \uBAB8\uC18D\uC5D0 \uC788\uB358 \uCF54\uC778\uC774 \uB5A8\uC5B4\uC838\uC788\uB2E4. "
  - ButtonText: "\uC2AC\uB77C\uC784 \uC704\uC5D0 \uB098\uBB47\uC78E\uC744 \uB36E\uC5B4\uC900\uB2E4."
    EffectType: 1
    EffectValue: 10
    Items: []
    PinBalls: []
    ChoiceText: "\uC2AC\uB77C\uC784\uC740 \uC88B\uC544\uD558\uC9C0 \uC54A\uC558\uC9C0\uB9CC
      \uADF8\uB798\uB3C4 \uAE30\uBD84\uC774 \uC88B\uC544\uC84C\uB2E4."
  - ButtonText: "\uB054\uCC0D\uD558\uAC8C \uC0DD\uACBC\uC73C\uB2C8 \uBC1F\uC544\uBC84\uB9B0\uB2E4."
    EffectType: 2
    EffectValue: 0
    Items: []
    PinBalls: []
    ChoiceText: "\uC544\uBB34\uB7F0 \uC774\uB4DD\uB3C4 \uC190\uD574\uB3C4 \uBCF4\uC9C0
      \uBABB\uD588\uB2E4."
